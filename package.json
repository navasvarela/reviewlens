{
  "name": "walkdiff",
  "version": "0.2.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "walkdiff": "pnpm -s build:ui > /dev/null && node packages/cli/src/main.ts",
    "build:ui": "pnpm --filter @walkdiff/report-ui --filter @walkdiff/app-ui build",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/report-ui/tsconfig.json && tsc -p packages/app-ui/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
